# Данный скрипт генерирует hex-файл с абсолютным адресом, пригодный для зашивки
# с помощью STM32CubeProgrammer.
#
# На данный момент имеется только конфигурация 0
#
Test_ROM.rom -Binary -offset 0x08008000

-generate 0x0800A002 0x0800A010 -repeat-string %00%FF%FF%FF%FF%FF%FF%FF%FF%FF%FF%FF%FF%FF

-o Test_ROM.hex -Intel -obs=64
